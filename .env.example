# ---- Core ----
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
PORT=3000

# Proxies in front of the app that append to X-Forwarded-For. Decides the client
# IP used by rate limits (lib/client-ip.ts): 0 in dev, 1 behind nginx, 2 behind a
# CDN + nginx. Too high lets clients pick their own IP; too low rate-limits the proxy.
TRUSTED_PROXY_HOPS=0

# ---- Backing services (docker compose up -d) ----
DATABASE_URL="postgresql://pokehub:pokehub@localhost:5433/pokehub?schema=public"
REDIS_URL="redis://localhost:6379"

# S3-compatible object storage. MinIO locally, Cloudflare R2 in production.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="pokehub-saves"
S3_ACCESS_KEY_ID="pokehub"
S3_SECRET_ACCESS_KEY="pokehub-dev-secret"

# Save service (.NET + PKHeX.Core). Internal only; published on localhost in dev.
SAVE_SERVICE_URL="http://localhost:5080"

# ---- Game detection ----
# Official-dump hashes live in data/rom-hashes.json (npm run roms:import).
# true = also accept supported game codes that have no entry there. Keep false.
ALLOW_UNLISTED_ROMS=false

# Where the iframe loads EmulatorJS from. Pinned version; self-host in production
# (ADR-009) by pointing this at /emulator/data/ once those files are vendored.
NEXT_PUBLIC_EMULATORJS_DATA="https://cdn.emulatorjs.org/4.2.3/data/"

# ---- Bootstrap (npm run setup:owner) ----
OWNER_USERNAME="owner"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me-please"
