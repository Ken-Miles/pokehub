# ---- Core ----
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
PORT=3000

# Proxies in front of the app that append to X-Forwarded-For. Decides the client
# IP used by rate limits (lib/client-ip.ts): 0 in dev, 1 behind nginx, 2 behind a
# CDN + nginx. Too high lets clients pick their own IP; too low rate-limits the proxy.
TRUSTED_PROXY_HOPS=0

# ---- Backing services (docker compose up -d) ----
DATABASE_URL="postgresql://pokehub:pokehub@localhost:5433/pokehub?schema=public"
REDIS_URL="redis://localhost:6379"

# S3-compatible object storage. MinIO locally, Cloudflare R2 in production.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="pokehub-saves"
S3_ACCESS_KEY_ID="pokehub"
S3_SECRET_ACCESS_KEY="pokehub-dev-secret"

# Save service (.NET + PKHeX.Core). Internal only; published on localhost in dev.
SAVE_SERVICE_URL="http://localhost:5080"

# ---- Game detection ----
# Official-dump hashes live in data/rom-hashes.json (npm run roms:import).
# true = also accept supported game codes that have no entry there. Keep false.
ALLOW_UNLISTED_ROMS=false

# FR-36 test bots (ADR-023). The site and the bot host share the key; leave it unset to turn bots off.
# BOT_HOST_SECRET=<32+ random characters>
# Bot host only: a read-only folder of the operator's own game files. Never uploaded anywhere.
# BOT_GAMES_DIR=./bots/games
# BOT_SITE_URL=http://localhost:3000

# FR-38 DS online (Phase 5). The site and ds-gateway share the key; leave unset to turn DS online off.
# docker compose --profile ds up -d ds-gateway
# DS_GATEWAY_SECRET=<32+ random characters>
# DS_GATEWAY_URL=ws://localhost:8790
# Gateway only: where it asks the site about sign-ins (default http://host.docker.internal:3000).
# DS_SITE_URL=http://host.docker.internal:3000

# The emulator (mGBA built to WebAssembly, ADR-011) is self-hosted from
# public/emulator/core/ — rebuild with npm run emulator:build. No setting needed.

# ---- Bootstrap (npm run setup:owner) ----
OWNER_USERNAME="owner"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me-please"
