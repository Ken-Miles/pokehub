!tests/fixtures/link-test.gba
!tests/fixtures/net-test.gba
!tests/fixtures/rfu-test.gba
*.gb
# except our own 32 KB homebrew GB cable tests (built by tests/fixtures/link-rom/build-gb.py; no game data)
!tests/fixtures/link-test.gb
!tests/fixtures/link-test-gbc.gb
*.gbc
*.nds
*.sav

# No-Intro DATs (download by hand; see scripts/import-nointro-dat.ts)
data/no-intro/*.dat

