# Copy to ~/websites/pokehub/shared/.env on macserver and fill in. Shared by both colours,
# the worker and the services. Keep values free of quotes and spaces (systemd reads this file).

# ---- Core
NEXTAUTH_SECRET=            # openssl rand -base64 32
NEXTAUTH_URL=https://pokehub.aidenpearce.space
TRUSTED_PROXY_HOPS=2        # cloudflared + nginx; check the client IP after go-live (deploy/README.md)
ALLOW_UNLISTED_ROMS=false

# ---- Backing services (deploy/compose.yml)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://pokehub:SAME_PASSWORD@127.0.0.1:5433/pokehub
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=pokehub
S3_ACCESS_KEY_ID=any
S3_SECRET_ACCESS_KEY=any

# ---- Email (Resend; free plan = 100/day, 3,000/month, the app stops before either cap)
RESEND_API_KEY=
MAIL_FROM=Pokémon Hub <noreply@pokehub.aidenpearce.space>
MAIL_DAILY_LIMIT=90
MAIL_MONTHLY_LIMIT=2900

# ---- Save service (unix socket, see compose.yml)
SAVE_SERVICE_SOCKET=/home/j/websites/pokehub/run/save.sock

# ---- Optional features: leave unset to keep them off
# BOT_HOST_SECRET=          # test bots: the bot host does NOT run on macserver (it holds game files)
# DS_GATEWAY_SECRET=        # DS online: needs the ds profile and /dev/net/tun; not set up here yet
