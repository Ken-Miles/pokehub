{
  "name": "pokemon-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Play your own Pokémon games in the browser, keep cloud saves, and trade with friends.",
  "scripts": {
    "dev": "tsx watch --ignore ./.next server/main.ts",
    "dev:worker": "tsx watch worker/main.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "start:worker": "NODE_ENV=production tsx worker/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:integration": "vitest --run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "services:up": "docker compose up -d --build",
    "services:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "setup:owner": "tsx scripts/create-owner.ts",
    "bots": "tsx bots/main.ts",
    "bots:create": "tsx scripts/create-bot.ts",
    "roms:import": "tsx scripts/import-nointro-dat.ts",
    "emulator:build": "sh scripts/build-emulator.sh",
    "spike:link": "tsx spikes/link-latency/server.ts",
    "spike:link:load": "tsx spikes/link-latency/load.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.0",
    "bullmq": "^5.34.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "next": "16.0.7",
    "next-auth": "4.24.13",
    "pino": "^9.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.5",
    "tsx": "^4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.9",
    "typescript": "^5.7",
    "vitest": "^2.1.8"
  }
}
