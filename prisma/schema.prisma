// Pokémon Hub data model. Source of truth for the vault note "Data model".
// Save blobs live in object storage; rows here only reference them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  MOD
  ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum EmailTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// Where a game runs (lib/games.ts PLATFORMS). DS codes reuse GBA ones, so a
/// slot's game is platform + gameCode, never the code alone.
enum Platform {
  GB
  GBA
  NDS
  N3DS
}

enum SlotOrigin {
  NEW
  IMPORTED
}

enum SaveSource {
  EMULATOR
  IMPORT
  TRADE
  RESTORE
  ADMIN
}

enum PokemonOrigin {
  NATIVE
  IMPORTED
}

enum RegistryStatus {
  OK
  CLONE_SUSPECT
  FROZEN
}

enum TradeState {
  OPEN
  COMMITTING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum FlagStatus {
  OPEN
  DISMISSED
  ACTIONED
}

/// FR-26: SAME_DEVICE = every seat is one player's own slot, linked in one page;
/// NETWORK = friends in their own browsers, lockstep over the network (ADR-012);
/// CABLE = two Game Boys (or GBAs), each running only its own game, cable relayed (FR-34, ADR-020/021);
/// WIRELESS = a room of 2–5 Gen 3 Wireless Adapters, each running only its own game (FR-35, ADR-022).
enum LinkMode {
  SAME_DEVICE
  NETWORK
  CABLE
  WIRELESS
}

enum LinkState {
  LOBBY
  ACTIVE
  ENDED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------- accounts

model User {
  id               String     @id @default(cuid())
  username         String     @unique // stored lowercase
  email            String     @unique // stored lowercase
  emailVerifiedAt  DateTime?
  passwordHash     String // argon2id
  role             Role       @default(PLAYER)
  status           UserStatus @default(ACTIVE)
  statusReason     String? // shown to the user at login when suspended/banned (FR-01)
  suspendedUntil   DateTime? // SUSPENDED only; null = until lifted
  friendCode       String     @unique // 0000-0000-0000
  tokenVersion     Int        @default(0) // bump = sign out everywhere
  acceptUnverified Boolean    @default(false) // ADR-008
  isTester         Boolean    @default(false) // FR-32: may use the save drop box; set by an admin
  isBot            Boolean    @default(false) // FR-36: a test bot; only the bot host acts as it, never a login
  emulatorControls Json       @default("{}") @map("emulator_controls")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  slots           GameSlot[]
  emailTokens     EmailToken[]
  authEvents      AuthEvent[]
  friendsSent     Friendship[]  @relation("requester")
  friendsReceived Friendship[]  @relation("addressee")
  blocking        Block[]       @relation("blocker")
  blockedBy       Block[]       @relation("blocked")
  reportsFiled    Report[]      @relation("reporter")
  reportsAgainst  Report[]      @relation("reportTarget")
  dropFiles       DropFile[]
  linkHosted      LinkSession[]
  linkSeats       LinkSeat[]
  dsConsole       DsConsole?

  @@map("users")
}

/// FR-39: a site account's emulated DS. Its MAC isn't stored: it's lib/ds-tunnel.ts#dsMac(userId).
model DsConsole {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The Nintendo WFC user ID our sign-in gave this DS; every later sign-in must use it.
  wfcUserId    String?  @unique
  /// The DS's three Wi-Fi access point blocks as it last wrote them (768 bytes), restored at boot.
  wifiSettings Bytes?
  updatedAt    DateTime @updatedAt

  @@map("ds_consoles")
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailTokenKind
  tokenHash String         @unique // sha256 of the emailed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId])
  @@map("email_tokens")
}

model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String
  event     String // login | login_failed | login_blocked | logout | password_reset_requested | password_reset
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("auth_events")
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

model Block {
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@map("blocks")
}

// ---------------------------------------------------------------- saves

model GameSlot {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotNumber Int // 1..3, unique among live slots (partial index in migration)
  platform   Platform   @default(GBA)
  gameCode   String // GBA/DS: header code, e.g. BPEE. 3DS: version from the save, e.g. OR
  language   String // GBA/DS: last header letter (E, P, O, J, K, D, F, I, S). 3DS: from the save
  origin     SlotOrigin

  trainerName String?
  trainerId   Int?
  secretId    Int?

  currentVersionId   String?      @unique
  currentVersion     SaveVersion? @relation("current", fields: [currentVersionId], references: [id])
  // ADR-007: versions older than this cannot be restored.
  lastTradeVersionId String?      @unique
  lastTradeVersion   SaveVersion? @relation("lastTrade", fields: [lastTradeVersionId], references: [id])
  // ADR-005: the only lock. Postgres is the source of truth.
  lockedByTradeId    String?
  lockedByTrade      Trade?       @relation("locks", fields: [lockedByTradeId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  versions  SaveVersion[]     @relation("versions")
  registry  PokemonRegistry[]
  tradesA   Trade[]           @relation("aSlot")
  tradesB   Trade[]           @relation("bSlot")
  linkSeats LinkSeat[]

  @@index([userId])
  @@map("game_slots")
}

/// Immutable (NFR-07). Restores and trades create new rows.
model SaveVersion {
  id             String        @id @default(cuid())
  slotId         String
  slot           GameSlot      @relation("versions", fields: [slotId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         SaveVersion?  @relation("lineage", fields: [parentId], references: [id])
  children       SaveVersion[] @relation("lineage")
  seq            Int // 1, 2, 3… per slot
  storageKey     String
  sha256         String
  size           Int
  playSeconds    Int
  source         SaveSource
  tradeId        String?
  restoredFromId String?
  createdAt      DateTime      @default(now())

  currentFor   GameSlot?         @relation("current")
  lastTradeFor GameSlot?         @relation("lastTrade")
  flags        SaveFlag[]
  sightings    PokemonSighting[]

  @@unique([slotId, seq])
  @@index([tradeId])
  @@map("save_versions")
}

// ---------------------------------------------------------------- registry (FR-20, FR-22)

model PokemonRegistry {
  fingerprint        String         @id // sha256(PID+TID+SID+OT)[0..32]
  species            Int
  otName             String
  tid                Int
  sid                Int
  currentSlotId      String? // null = released (slot deleted)
  currentSlot        GameSlot?      @relation(fields: [currentSlotId], references: [id], onDelete: SetNull)
  origin             PokemonOrigin
  status             RegistryStatus @default(OK)
  firstSeenVersionId String
  firstSeenAt        DateTime       @default(now())
  lastSeenAt         DateTime       @default(now())

  sightings PokemonSighting[]

  @@index([currentSlotId])
  @@map("pokemon_registry")
}

/// Written only when something changed, so FR-22 can see a Pokémon "appear gradually".
model PokemonSighting {
  id          String          @id @default(cuid())
  fingerprint String
  pokemon     PokemonRegistry @relation(fields: [fingerprint], references: [fingerprint], onDelete: Cascade)
  versionId   String
  version     SaveVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  species     Int
  level       Int
  box         Int // -1 = party
  slot        Int
  createdAt   DateTime        @default(now())

  @@index([fingerprint, createdAt])
  @@map("pokemon_sightings")
}

// ---------------------------------------------------------------- trading (phase 2)

model Trade {
  id               String     @id @default(cuid())
  state            TradeState @default(OPEN)
  aSlotId          String
  aSlot            GameSlot   @relation("aSlot", fields: [aSlotId], references: [id])
  bSlotId          String?
  bSlot            GameSlot?  @relation("bSlot", fields: [bSlotId], references: [id])
  aBaseVersionId   String?
  bBaseVersionId   String?
  aOffer           Json?
  bOffer           Json?
  aConfirmedAt     DateTime?
  bConfirmedAt     DateTime?
  aResultVersionId String?
  bResultVersionId String?
  failureReason    String?
  expiresAt        DateTime
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  completedAt      DateTime?

  lockedSlots GameSlot[] @relation("locks")

  @@index([state, expiresAt])
  @@map("trades")
}

// ---------------------------------------------------------------- link play (phase 1b)

/// FR-26: a recorded link-cable session between 2–4 GBAs. Every browser runs
/// every seat's game (ADR-012), so the record pins exactly what each seat
/// started from: the game dump, the save version, the clock and the emulator build.
/// A Pokémon may change slots in-game only between seats of one session (lib/registry.ts).
model LinkSession {
  id         String    @id @default(cuid())
  hostId     String
  host       User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  mode       LinkMode
  state      LinkState @default(LOBBY)
  /// Every GBA's clock starts here (ms since epoch), so linked games agree on the time.
  rtcEpochMs BigInt?
  inputDelay Int? // frames (lib/client/lockstep.ts)
  coreBuild  String? // emulator build every browser must run (public/emulator/core/build.json sha256)
  endReason  String? // ended | left | disconnected | desync | expired
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  endedAt    DateTime?
  /// Which deploy colour (or "dev") holds this session's relay state (lib/deploy.ts). Null = unclaimed.
  relayOwner String?

  seats LinkSeat[]

  @@index([state, createdAt])
  @@index([hostId])
  @@map("link_sessions")
}

/// One GBA on the cable. Seat 0 is the cable's parent (the host).
model LinkSeat {
  id             String      @id @default(cuid())
  sessionId      String
  session        LinkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seat           Int
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotId         String?
  slot           GameSlot?   @relation(fields: [slotId], references: [id], onDelete: SetNull)
  /// SHA-1 of the game file this seat plays; every browser must load the same dump.
  romSha1        String?
  coreBuild      String?
  /// In the session (cable accepted, room joined, game checked); null = only invited.
  readyAt        DateTime?
  /// The slot's save version when the session started; every browser boots this seat from it.
  startVersionId String?
  /// Left a wireless room that kept running (FR-35).
  leftAt         DateTime?
  createdAt      DateTime    @default(now())

  @@unique([sessionId, seat])
  @@unique([sessionId, slotId])
  @@index([slotId])
  @@index([userId])
  @@map("link_seats")
}

// ---------------------------------------------------------------- trust & moderation

model SaveFlag {
  id           String      @id @default(cuid())
  versionId    String
  version      SaveVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind         String // clone_conflict | duplicate_in_save | implausible_diff …
  detail       Json
  status       FlagStatus  @default(OPEN)
  reviewedById String?
  createdAt    DateTime    @default(now())
  reviewedAt   DateTime?

  @@index([status, createdAt])
  @@map("save_flags")
}

model Report {
  id            String       @id @default(cuid())
  reporterId    String
  reporter      User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId  String?
  targetUser    User?        @relation("reportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetTradeId String?
  reason        String
  status        ReportStatus @default(OPEN)
  resolvedById  String?
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?

  @@index([status, createdAt])
  @@map("reports")
}

/// FR-32 / ADR-015: a file a tester dropped for the owner. Not a save version:
/// never in a slot, the registry or a trade, and kept even if the save service
/// can't read it. The parse fields are for display only.
model DropFile {
  id          String   @id @default(cuid())
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fileName    String
  size        Int
  sha256      String
  storageKey  String   @unique
  note        String?
  readable    Boolean
  parseError  String? // save service error code when not readable
  generation  Int?
  gameVersion String? // version the save reports, e.g. E, OR
  trainerName String?
  trainerId   Int?
  createdAt   DateTime @default(now())

  @@index([uploaderId, createdAt])
  @@index([createdAt])
  @@map("drop_files")
}

/// One Pokémon moved by an in-game link trade (cable, wireless room or /link),
/// written when the receiving save is ingested (lib/save-pipeline.ts). Plain ids,
/// no FKs, so the history outlives slot purges. Append-only, like audit_events.
model LinkTrade {
  id          String   @id @default(cuid())
  sessionId   String
  mode        LinkMode
  fingerprint String
  species     Int
  speciesName String
  nickname    String
  level       Int
  fromUserId  String
  fromSlotId  String
  toUserId    String
  toSlotId    String
  /// The receiving slot's save version that first showed the Pokémon.
  versionId   String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
  @@index([fingerprint])
  @@map("link_trades")
}

/// Append-only (FR-24): a trigger in the initial migration rejects UPDATE/DELETE.
model AuditEvent {
  id         String   @id @default(cuid())
  // Plain id, no FK: a cascading SET NULL would be an UPDATE, which the trigger forbids.
  actorId    String?
  action     String // slot.create, save.import, save.restore, trade.state …
  targetType String
  targetId   String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_events")
}
